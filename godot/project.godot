; Engine configuration file.
; This project owns only the interactive exploration surface. React remains the
; shell for narration, inventory, combat, saves, and destination commands.

config_version=5

[application]

config/name="Solitaire Exploration"
run/main_scene="res://main.tscn"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.018, 0.047, 0.102, 1)
